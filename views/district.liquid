{% render 'partials/head.liquid' %}


<main>

    {% assign districts = "algemeen,nieuw-west,zuidoost,oost" | split: "," %}
    {% if districts contains district %}

    <section class="district-hero">
        <h2>{{ district | capitalize }}</h2>
        {% render 'partials/doelgroep-filter.liquid' %}
    </section>

    {% else %}
    <h2>404</h2>
    {% endif %}

    {% comment %} {% if district == 'oost' %}
    {% elsif district == 'zuidoost' %}
    {% elsif district == 'nieuw-west' %}
    {% elsif district == 'algemeen' %}
    {% else %}
    <p>hier komt 404 </p>
    {% endif %} {% endcomment %}

    <section class="district-articles">
        {% for story in stories %}
        <a href="/{{ story.district }}/test" class="single-article-link">
            <article class="single-article {{ story.district}}">
                {% if story.cover %}
                <img class="article-cover" src="https://fdnd-agency.directus.app/assets/{{ story.cover }}" alt="">
                {% else %}
                <img class="article-cover fallback" src="/assets/Compact_Blurple_{{ district }}.png"
                    alt="Geen afbeelding beschikbaar">
                {% endif %} <div class="article-card-content">
                    <time class="article-date">{{ story.date | date: "%d-%m-%Y" }}</time>
                    <h3 class="article-title">{{ story.title }}</h3>
                    <p class="article-intro">{{ story.intro }}</p>
                </div>
            </article>
        </a>
        {% endfor %}
    </section>


</main>


{% render 'partials/foot.liquid' %}