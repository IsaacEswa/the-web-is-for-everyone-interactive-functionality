{% render 'partials/head.liquid' %}


<main>

    {% assign districts = "algemeen,nieuw-west,zuidoost,oost" | split: "," %}
    {% if districts contains district %}

    <section class="district-hero">
        <h2>{{ district | capitalize }}</h2>
        {% comment %} {% render 'partials/doelgroep-filter.liquid' %} {% endcomment %}

        <section class="targetgroup-filter-container">
            <form action="/{{ district }}" method="GET">
                <label>
                    Artikelen voor


                    <select name="target_group">
                        <option value="" {% if selectedTargetGroup=="" %}selected{% endif %}>Iedereen</option>
                        <option value="wijkbewoner" {% if selectedTargetGroup=="wijkbewoner" %}selected{% endif %}>
                            wijkbewoner</option>
                        <option value="student" {% if selectedTargetGroup=="student" %}selected{% endif %}>student
                        </option>
                        <option value="wijkpartner" {% if selectedTargetGroup=="wijkpartner" %}selected{% endif %}>
                            wijkpartner
                        </option>
                        <option value="HvA medewerker" {% if selectedTargetGroup=="HvA medewerker" %}selected{% endif
                            %}>HvA
                            medewerker
                        </option>
                    </select>

                    <input type="submit" value="filter">
                </label>
            </form>
        </section>

        <details>
            <summary>Sorteer artikelen</summary>
            <ul>
                <li class="sort-list"><a href="/{{ district }}">Meest relevant</a></li>
                <li class="sort-list"><a href="/{{ district }}/oud-nieuw">Oud-nieuw</a></li>
                <li class="sort-list"><a href="/{{ district }}/nieuw-oud">Nieuw-oud</a></li>
            </ul>
        </details>

    </section>

    {% else %}
    <h2>404</h2>
    {% endif %}

    <section class="district-articles">
        {% for story in stories %}
        <a href="/{{ story.district }}/{{ story.slug }}" class="single-article-link">
            <article class="single-article {{ story.district}}">
                {% if story.cover %}
                <img class="article-cover" src="https://fdnd-agency.directus.app/assets/{{ story.cover }}" alt="">
                {% else %}
                <img class="article-cover fallback" src="/assets/Compact_Blurple_{{ district }}.png"
                    alt="Geen afbeelding beschikbaar">
                {% endif %} <div class="article-card-content">
                    <time class="article-date">{{ story.date | date: "%d-%m-%Y" }}</time>
                    <h3 class="article-title">{{ story.title }}</h3>
                    <p class="article-intro">{{ story.intro }}</p>
                </div>
            </article>
        </a>
        {% endfor %}
    </section>

</main>


{% render 'partials/foot.liquid' %}