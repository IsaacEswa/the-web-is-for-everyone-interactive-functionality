{% render 'partials/head.liquid' %}


<main>

    {% assign districts = "algemeen,nieuw-west,zuidoost,oost" | split: "," %}
    {% if districts contains district %}

    <section class="district-hero">
        <h2>{{ district | capitalize }}</h2>

        <div class="filter-and-sort">

            {% comment %} <div class="targetgroup-filter-container">
                <form id="targetgroup-form" action="/{{ district }}" method="GET">
                    <label>
                        Artikelen voor
                        <select name="target_group" id="targetgroup-select">
                            <option value="" {% if selectedTargetGroup=="" %}selected{% endif %}>Iedereen</option>
                            <option value="wijkbewoner" {% if selectedTargetGroup=="wijkbewoner" %}selected{% endif %}>
                                wijkbewoner
                            </option>
                            <option value="student" {% if selectedTargetGroup=="student" %}selected{% endif %}>student
                            </option>
                            <option value="wijkpartner" {% if selectedTargetGroup=="wijkpartner" %}selected{% endif %}>
                                wijkpartner
                            </option>
                            <option value="HvA medewerker" {% if selectedTargetGroup=="HvA medewerker" %}selected{%
                                endif %}>HvA
                                medewerker</option>
                        </select>
                    </label>

                    <input id="filter-button" type="submit" value="filter">
                </form>
            </div> {% endcomment %}

            {% comment %} <div class="articles-sort-container">
                <details>
                    <summary>Sorteer artikelen</summary>
                    <ul>
                        <li class="sort-list">
                            <a
                                href="/{{ district }}{% if selectedTargetGroup != "" %}?target_group={{ selectedTargetGroup }}{% endif %}">
                                Meest relevant
                            </a>
                        </li>
                        <li class="sort-list">
                            <a
                                href="/{{ district }}/oud-nieuw{% if selectedTargetGroup != "" %}?target_group={{ selectedTargetGroup }}{% endif %}">
                                Oud-nieuw
                            </a>
                        </li>
                        <li class="sort-list">
                            <a
                                href="/{{ district }}/nieuw-oud{% if selectedTargetGroup != "" %}?target_group={{ selectedTargetGroup }}{% endif %}">
                                Nieuw-oud
                            </a>
                        </li>
                    </ul>
                </details>
            </div> {% endcomment %}

            <form action="/{{ district }}" method="GET">
                <label class="targetgroup-select-container">
                    <span>Artikelen voor</span>

                    <select id="targetgroup-select" name="target_group">
                        <option value="" {% if selectedTargetGroup=="" %}selected{% endif %}>Iedereen
                        </option>
                        <option value="wijkbewoner" {% if selectedTargetGroup=="wijkbewoner" %}selected{% endif %}>
                            Wijkbewoner
                        </option>
                        <option value="student" {% if selectedTargetGroup=="student" %}selected{% endif %}>Student
                        </option>
                        <option value="wijkpartner" {% if selectedTargetGroup=="wijkpartner" %}selected{% endif %}>
                            Wijkpartner
                        </option>
                        <option value="HvA medewerker" {% if selectedTargetGroup=="HvA medewerker" %}selected{% endif
                            %}>HvA
                            medewerker</option>
                    </select>
                </label>

                <label class="sort-select-container">
                    <span>Sorteren op</span>

                    <select id="sort-select" name="date">
                        <option value="" {% if selectedSort=="" %}selected{% endif %} disabled hidden>kies een volgorde
                        </option>
                        <option value="oud-nieuw" {% if selectedSort=="oud-nieuw" %}selected{% endif %}>
                            Oud naar nieuw</option>
                        <option value="nieuw-oud" {% if selectedSort=="nieuw-oud" %}selected{% endif %}>Nieuw naar oud
                        </option>
                    </select>
                </label>

                <input id="filter-button" type="submit" value="filter">
            </form>

            {% comment %} <p>Je hebt gefilterd op {{ selectedTargetGroup }}</p>
            <p>Je hebt gesorteerd op {{ selectedSort }}</p> {% endcomment %}
            {% comment %} <p>Er zijn {{ stories | size }} artikelen gevonden</p> {% endcomment %}

        </div>

    </section>

    {% else %}
    <h2>404</h2>
    {% endif %}

    <section class="district-articles">
        <p><b>{{ stories | size }}</b> artikel(en) gevonden</p>

        {% for story in stories %}
        <a href="/{{ story.district }}/{{ story.slug }}" class="single-article-link">
            <article class="single-article {{ story.district}}">
                {% if story.cover %}
                <img class="article-cover" src="https://fdnd-agency.directus.app/assets/{{ story.cover }}" alt="">
                {% else %}
                <img class="article-cover fallback" src="/assets/Compact_Blurple_{{ district }}.png"
                    alt="Geen afbeelding beschikbaar">
                {% endif %} <div class="article-card-content">
                    <time class="article-date">{{ story.date | date: "%d-%m-%Y" }}</time>
                    <h3 class="article-title">{{ story.title }}</h3>
                    <p class="article-intro">{{ story.intro }}</p>
                </div>
            </article>
        </a>
        {% endfor %}
    </section>

</main>


{% render 'partials/foot.liquid' %}